---
// 全ページ共通の骨組み（ヘッダー・フッター）です。
// ナビゲーションの項目は src/lib/content.ts の nav で管理しています。
import { site, nav } from '../lib/content';
import '../styles/global.css';

interface Props {
  title?: string;        // ページ名。省略するとトップページ扱い
  description?: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;

const pageTitle = title
  ? `${title}｜${site.lab.name_ja}`
  : `${site.lab.name_ja}｜芝浦工業大学`;
const desc = description ?? site.description;
const current = Astro.url.pathname;
const canonical = new URL(current, Astro.site);
const ogImage = new URL('/ogp.png', Astro.site);

// ナビの現在地判定。/news/記事名/ のような下層ページでも親を光らせます。
const isCurrent = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#13203a" />

    <!-- SNSやSlackにURLを貼ったときの表示（画像は public/ogp.png） -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.lab.name_ja} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@600&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">本文へスキップ</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">
          <span class="brand-ja">{site.lab.name_ja}</span>
          <span class="brand-en">{site.lab.name_en}</span>
        </a>

        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="visually-hidden">メニューを開く</span>
          <span class="bar" aria-hidden="true"></span>
          <span class="bar" aria-hidden="true"></span>
          <span class="bar" aria-hidden="true"></span>
        </button>

        <nav class="site-nav" id="site-nav" aria-label="サイト内">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  <span class="ja">{item.label}</span>
                  <span class="sub">{item.sub}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-lab">
          <p class="footer-name">{site.lab.name_ja}</p>
          <p class="footer-name-en">{site.lab.name_en}</p>
          <p class="footer-prof">
            {site.professor.affiliation}　{site.professor.title}　{site.professor.name_ja}
          </p>
        </div>

        <dl class="footer-meta">
          <div>
            <dt>ゼミ実施</dt>
            <dd>{site.location.seminar.campus}<br />{site.location.seminar.address}</dd>
          </div>
          <div>
            <dt>教員所属</dt>
            <dd>{site.location.office.campus}<br />{site.location.office.room}</dd>
          </div>
          <div>
            <dt>連絡先</dt>
            <dd>
              {site.contact.email_masked}
              <span class="footer-note">迷惑メール対策のため ◎ を @ に置き換えてください</span>
            </dd>
          </div>
        </dl>

        <p class="copyright">
          © {new Date().getFullYear()} {site.lab.name_ja}（芝浦工業大学）
        </p>
      </div>
    </footer>

    <script>
      // スマートフォン用のメニュー開閉です。
      const toggle = document.querySelector('.nav-toggle');
      const siteNav = document.getElementById('site-nav');
      const label = toggle?.querySelector('.visually-hidden');
      if (toggle && siteNav) {
        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', String(open));
          siteNav.classList.toggle('is-open', open);
          if (label) label.textContent = open ? 'メニューを閉じる' : 'メニューを開く';
        };

        toggle.addEventListener('click', () => {
          setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });

        // Escapeキーで閉じます。
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            toggle.focus();
          }
        });

        // 画面を横向きにするなどして広い表示に戻ったときは状態を戻します。
        const wide = window.matchMedia('(min-width: 60.001rem)');
        wide.addEventListener('change', (e) => { if (e.matches) setOpen(false); });
      }
    </script>

    <style>
      .skip {
        position: absolute; left: -9999px; top: 0; z-index: 100;
        background: var(--navy-900); color: #fff; padding: .7rem 1.2rem;
      }
      .skip:focus { left: 0; }

      /* ---------- ヘッダー ---------- */
      .site-header {
        background: var(--paper);
        border-bottom: 1px solid var(--rule);
        position: sticky; top: 0; z-index: 50;
      }
      .header-inner {
        display: flex; align-items: center; justify-content: space-between;
        gap: 1.5rem; min-height: 4.5rem;
      }
      .brand { text-decoration: none; display: block; flex: none; }
      .brand-ja {
        display: block; font-size: 1rem; font-weight: 700; color: var(--navy-900);
        line-height: 1.4;
      }
      .brand-en {
        display: block; font-size: .66rem; letter-spacing: .04em;
        color: var(--muted); line-height: 1.4;
      }

      .site-nav ul {
        list-style: none; display: flex; gap: 0; margin: 0; padding: 0;
        flex-wrap: wrap; justify-content: flex-end;
      }
      .site-nav a {
        display: block; text-decoration: none; color: var(--text);
        padding: .5rem .7rem; text-align: center;
        border-bottom: 2px solid transparent;
      }
      .site-nav .ja { display: block; font-size: .82rem; font-weight: 500; line-height: 1.4; }
      .site-nav .sub {
        display: block; font-size: .63rem; letter-spacing: .06em;
        color: var(--muted); line-height: 1.4;
      }
      .site-nav a:hover { color: var(--teal-600); }
      .site-nav a[aria-current="page"] {
        color: var(--navy-900); border-bottom-color: var(--teal-600);
      }
      .site-nav a[aria-current="page"] .sub { color: var(--teal-600); }

      .nav-toggle {
        display: none; flex-direction: column; gap: 4px; justify-content: center;
        width: 2.75rem; height: 2.75rem; padding: 0;
        background: none; border: 1px solid var(--rule); border-radius: 2px;
        cursor: pointer; flex: none;
      }
      .nav-toggle .bar {
        display: block; width: 1.15rem; height: 2px; margin-inline: auto;
        background: var(--navy-900);
      }

      @media (max-width: 40rem) {
        .brand-ja { font-size: .88rem; }
        .brand-en { display: none; }
      }

      @media (max-width: 60rem) {
        .header-inner { flex-wrap: wrap; min-height: 3.75rem; }
        .nav-toggle { display: flex; }
        .site-nav {
          display: none; width: 100%; order: 3;
          border-top: 1px solid var(--rule); padding-block: .5rem 1rem;
        }
        .site-nav.is-open { display: block; }
        .site-nav ul { flex-direction: column; gap: 0; }
        .site-nav li + li { border-top: 1px solid var(--rule-soft); }
        .site-nav a {
          text-align: left; padding: .8rem .2rem;
          border-bottom: none; border-left: 2px solid transparent;
          display: flex; align-items: baseline; gap: .7rem;
        }
        .site-nav a[aria-current="page"] {
          border-left-color: var(--teal-600); padding-left: .8rem;
        }
        .site-nav .ja { font-size: .95rem; }
      }

      /* ---------- フッター ---------- */
      .site-footer {
        background: var(--navy-900); color: #c8d4e4;
        padding-block: 3rem 2rem; margin-top: 4rem;
        font-size: .85rem; line-height: 1.85;
      }
      .footer-inner { display: flex; flex-direction: column; gap: 2rem; }
      .footer-name { color: #fff; font-weight: 700; font-size: 1rem; margin: 0; }
      .footer-name-en { color: #8fa4c0; font-size: .72rem; margin: 0 0 .6rem; }
      .footer-prof { margin: 0; }

      .footer-meta {
        display: grid; gap: 1.5rem; margin: 0;
        padding-top: 2rem; border-top: 1px solid rgba(255,255,255,.14);
      }
      @media (min-width: 48rem) {
        .footer-meta { grid-template-columns: repeat(3, 1fr); }
      }
      .footer-meta dt {
        font-size: .68rem; letter-spacing: .12em; color: #8fc7c2;
        margin-bottom: .3rem; font-weight: 500;
      }
      .footer-meta dd { margin: 0; }
      .footer-note { display: block; font-size: .72rem; color: #8fa4c0; margin-top: .2rem; }

      .copyright {
        margin: 0; padding-top: 1.5rem; font-size: .75rem; color: #8fa4c0;
        border-top: 1px solid rgba(255,255,255,.14);
      }
    </style>
  </body>
</html>
