---
// トップページのイラスト（ことば・認知・データのつながりを表した図）です。
// 動きのない静止画で、手書きのSVGだけでできています。
// 図の中の言葉は content/site.yaml の graphic_words で変えられます。
import { site } from '../lib/content';

const words = site.graphic_words ?? [];

// 大きな点の位置。上から順に graphic_words の言葉が入ります。
// place: 'above' は点の上に、'below' は点の下に文字を置きます。
const nodes = [
  { x: 452, y:  96, r: 10, color: '#0f7a72', place: 'above' },
  { x: 300, y:  58, r:  8, color: '#13203a', place: 'above' },
  { x: 140, y: 130, r:  8, color: '#6f6fb0', place: 'above' },
  { x: 322, y: 232, r: 13, color: '#13203a', place: 'below' },
  { x: 108, y: 300, r:  8, color: '#3f7fb3', place: 'below' },
  { x: 262, y: 372, r:  9, color: '#0f7a72', place: 'below' },
  { x: 452, y: 332, r:  9, color: '#3f7fb3', place: 'below' },
  { x: 560, y: 196, r:  8, color: '#6f6fb0', place: 'above' },
];

// 小さな点（言葉のつかない点）
const dots = [
  { x: 200, y: 200, r: 3.5 }, { x: 390, y: 150, r: 4 },
  { x: 520, y: 260, r: 3.5 }, { x: 240, y: 290, r: 3 },
  { x: 360, y: 302, r: 4 },   { x: 170, y: 380, r: 3 },
  { x: 600, y: 120, r: 3.5 }, { x:  62, y: 210, r: 3 },
  { x: 500, y: 402, r: 3.5 }, { x: 348, y: 412, r: 3 },
  { x: 596, y: 320, r: 4 },   { x: 214, y:  96, r: 3 },
];

const p = (i: number) => nodes[i];
const d = (i: number) => dots[i];

// 線のつなぎ方
const links: [{ x: number; y: number }, { x: number; y: number }][] = [
  [p(0), p(1)], [p(0), p(7)], [p(0), p(3)], [p(1), p(2)], [p(1), p(3)],
  [p(2), p(4)], [p(2), p(3)], [p(4), p(5)], [p(5), p(3)], [p(5), p(6)],
  [p(6), p(3)], [p(6), p(7)], [p(3), d(1)], [p(2), d(0)], [d(0), p(3)],
  [d(2), p(7)], [d(2), p(6)], [d(4), p(3)], [d(4), p(5)], [d(6), p(7)],
  [d(7), p(4)], [d(5), p(5)], [d(8), p(6)], [d(9), p(5)], [d(3), p(4)],
  [d(10), p(6)], [d(11), p(1)],
];
---
<svg
  class="hero-graphic"
  viewBox="0 0 640 460"
  role="img"
  aria-label="ことば・認知・データが結びつくイメージ図"
>
  <defs>
    <radialGradient id="hero-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#e6f2f1" stop-opacity="1" />
      <stop offset="100%" stop-color="#e6f2f1" stop-opacity="0" />
    </radialGradient>
  </defs>

  <circle cx="330" cy="230" r="230" fill="url(#hero-glow)" />

  <g stroke="#cfdae6" stroke-width="1.2">
    {links.map((l) => <line x1={l[0].x} y1={l[0].y} x2={l[1].x} y2={l[1].y} />)}
  </g>

  <g fill="#b9cbdb">
    {dots.map((dot) => <circle cx={dot.x} cy={dot.y} r={dot.r} />)}
  </g>

  <g>
    {nodes.map((n) => <circle cx={n.x} cy={n.y} r={n.r} fill={n.color} />)}
  </g>

  <g class="labels" text-anchor="middle">
    {nodes.map((n, i) =>
      words[i] ? (
        <text x={n.x} y={n.place === 'above' ? n.y - n.r - 10 : n.y + n.r + 24}>
          {words[i]}
        </text>
      ) : null
    )}
  </g>
</svg>

<style>
  .hero-graphic { width: 100%; height: auto; }
  .labels text {
    font-size: 19px; font-weight: 500; fill: var(--navy-900);
    letter-spacing: .04em;
  }
</style>
