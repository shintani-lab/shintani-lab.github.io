---
// データ分析の流れを表す図です。
// 内容は content/research.yaml の approach（研究のアプローチ）と同じものを使うため、
// 文言を直せばトップページとこの図の両方に反映されます。
import Icon from './Icon.astro';
import { research } from '../lib/content';

const stepIcons: Record<number, string> = {
  1: 'text', 2: 'code', 3: 'chart', 4: 'people',
};
---
<figure class="flow-figure">
  <figcaption class="flow-caption">データ分析の流れ</figcaption>
  <ol class="flow" role="list">
    {research.approach.map((a) => (
      <li>
        <span class="flow-icon">
          <Icon name={stepIcons[a.step] ?? 'dot'} size={22} />
        </span>
        <div class="flow-body">
          <span class="flow-num">{String(a.step).padStart(2, '0')}</span>
          <h3>{a.title}</h3>
          <p>{a.body}</p>
        </div>
      </li>
    ))}
  </ol>
</figure>

<style>
  .flow-figure {
    margin: 0; padding: 1.75rem 1.5rem;
    background: var(--tint); border: 1px solid var(--rule);
  }
  .flow-caption {
    font-size: .72rem; font-weight: 500; letter-spacing: .14em;
    text-transform: uppercase; color: var(--teal-600); margin-bottom: 1.25rem;
  }

  .flow { list-style: none; margin: 0; padding: 0; }
  .flow li {
    display: grid; grid-template-columns: 2.75rem 1fr; gap: 1rem;
    position: relative; padding-bottom: 1.5rem;
  }
  .flow li:last-child { padding-bottom: 0; }

  /* 段階どうしをつなぐ縦線 */
  .flow li:not(:last-child)::before {
    content: ""; position: absolute; left: 1.3rem; top: 2.75rem; bottom: .4rem;
    width: 2px; background: var(--rule);
  }

  .flow-icon {
    display: grid; place-items: center;
    width: 2.75rem; height: 2.75rem; border-radius: 50%;
    background: var(--navy-900); color: #fff; position: relative; z-index: 1;
  }
  .flow li:nth-child(1) .flow-icon { background: #0f7a72; }
  .flow li:nth-child(2) .flow-icon { background: #3f7fb3; }
  .flow li:nth-child(3) .flow-icon { background: #6f6fb0; }
  .flow li:nth-child(4) .flow-icon { background: #13203a; }

  .flow-body { padding-top: .15rem; }
  .flow-num {
    font-size: .7rem; font-weight: 700; letter-spacing: .1em; color: var(--faint);
  }
  .flow-body h3 { font-size: .92rem; font-weight: 700; margin: .1rem 0 .35rem; }
  .flow-body p { margin: 0; font-size: .82rem; color: var(--muted); line-height: 1.8; }
</style>
