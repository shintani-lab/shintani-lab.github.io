---
// 公開経路の疎通確認用の仮ページです。
// 本実装に入る際に、このファイルは差し替えます。
const title = '認知言語学・言語データ分析研究室';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}｜準備中</title>
    <style>
      body {
        margin: 0; min-height: 100svh;
        display: grid; place-items: center;
        font-family: system-ui, "Hiragino Sans", "Yu Gothic", sans-serif;
        background: #fafbfc; color: #16233c;
      }
      main { text-align: center; padding: 2rem; }
      h1 { font-size: 1.25rem; font-weight: 700; margin: 0 0 .5rem; }
      p { color: #64738c; font-size: .9rem; margin: 0; }
    </style>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>Webサイトは準備中です。</p>
    </main>
  </body>
</html>
