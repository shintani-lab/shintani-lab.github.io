---
import Base from '../layouts/Base.astro';
import NewsList from '../components/NewsList.astro';
import { site, research } from '../lib/content';
import { getPublishedNews } from '../lib/news';

// News は新しい順に3件だけ表示します。draft: true の記事は出しません。
const allNews = await getPublishedNews();
const latestNews = allNews.slice(0, 3);

// キャッチコピーを読点「、」の後ろで区切ります。
// 区切りごとに span で囲むことで、「捉え、」のような語の途中で
// 改行されるのを防いでいます（文言を変えてもそのまま働きます）。
const catchcopyParts = site.catchcopy.main.split(/(?<=、)/);
---
<Base>
  <!-- ヒーロー -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="hero-id">
        <span class="hero-univ">{site.professor.affiliation}</span>
        <span class="hero-lab">{site.lab.name_ja}</span>
        <span class="hero-en">{site.lab.name_en}</span>
      </p>
      <h1 class="hero-copy">
        {catchcopyParts.map((part) => <span>{part}</span>)}
      </h1>
      <p class="hero-lead">{research.introduction[0]}</p>
      <div class="hero-actions">
        <a class="btn" href="/research/">研究内容を見る</a>
        <a class="btn btn--ghost" href="/join/">配属を考えている方へ</a>
      </div>
    </div>
  </section>

  <!-- 研究のアプローチ -->
  <section class="section section--tint">
    <div class="container">
      <h2 class="section-title">研究のアプローチ<span class="en">Approach</span></h2>
      <ol class="approach">
        {research.approach.map((a) => (
          <li>
            <span class="approach-num">{String(a.step).padStart(2, '0')}</span>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 研究分野 -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">研究分野<span class="en">Fields</span></h2>
      <ul class="fields">
        {research.fields.map((f) => <li>{f}</li>)}
      </ul>
      <p class="fields-note note">
        言語学・心理学・認知科学・教育工学の視点を組み合わせ、文系・理系の枠を越えて研究に取り組んでいます。
      </p>
    </div>
  </section>

  <!-- News -->
  <section class="section section--tint">
    <div class="container">
      <h2 class="section-title">
        News<span class="en">お知らせ</span>
        {allNews.length > 3 && <a class="section-more" href="/news/">一覧を見る →</a>}
      </h2>
      <NewsList items={latestNews} />
    </div>
  </section>
</Base>

<style>
  .hero { background: var(--paper); padding-block: 4rem; }

  .hero-id { margin: 0 0 1.5rem; }
  .hero-univ {
    display: block; font-size: .8rem; color: var(--muted);
    letter-spacing: .02em; margin-bottom: .35rem;
  }
  .hero-lab {
    display: block; font-size: 1.05rem; font-weight: 700; color: var(--navy-900);
    line-height: 1.5; padding-left: .75rem; border-left: 3px solid var(--teal-600);
  }
  .hero-en {
    display: block; font-size: .7rem; letter-spacing: .06em; color: var(--muted);
    padding-left: .75rem; border-left: 3px solid var(--teal-600); line-height: 1.6;
  }

  .hero-copy {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 5vw, 2.6rem);
    font-weight: 600; line-height: 1.6; letter-spacing: .01em;
    margin: 0 0 1.75rem; max-width: 46rem;
  }
  .hero-copy span { display: inline-block; }
  .hero-lead {
    max-width: var(--text-w); color: var(--text); margin: 0 0 2.25rem;
    font-size: 1rem;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  @media (max-width: 40rem) { .hero { padding-block: 2.5rem 2.5rem; } }

  /* 研究のアプローチ */
  .approach {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 1px; background: var(--rule);
    border: 1px solid var(--rule);
  }
  @media (min-width: 52rem) { .approach { grid-template-columns: repeat(4, 1fr); } }
  @media (min-width: 34rem) and (max-width: 51.999rem) {
    .approach { grid-template-columns: repeat(2, 1fr); }
  }
  .approach li { background: var(--paper); padding: 1.6rem 1.4rem; }
  .approach-num {
    display: block; font-size: .78rem; font-weight: 700; letter-spacing: .1em;
    color: var(--teal-600); margin-bottom: .6rem;
  }
  .approach h3 { font-size: .98rem; font-weight: 700; margin: 0 0 .5rem; }
  .approach p { margin: 0; font-size: .85rem; color: var(--muted); line-height: 1.85; }

  /* 研究分野 */
  .fields {
    list-style: none; margin: 0 0 1.5rem; padding: 0;
    display: grid; gap: .75rem;
  }
  @media (min-width: 34rem) { .fields { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 56rem) { .fields { grid-template-columns: repeat(3, 1fr); } }
  .fields li {
    border-left: 3px solid var(--teal-600);
    background: var(--tint);
    padding: .9rem 1.1rem;
    font-size: .92rem; font-weight: 500; color: var(--navy-900);
  }
  .fields-note { max-width: var(--text-w); }

  /* News の「一覧を見る」 */
  .section-title .section-more {
    margin-left: auto; font-size: .8rem; font-weight: 500; text-decoration: none;
  }
</style>
