---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { research } from '../lib/content';
---
<Base
  title="研究テーマ"
  description="卒業研究のテーマ例をご紹介します。ことばの意味や使用から、学習者の心理、異文化コミュニケーション、人とAIとの関わりまで多岐にわたります。"
>
  <PageHead title="研究テーマ" en="Projects" />

  <section class="section">
    <div class="container">
      <p class="prose lead">
        研究対象は、ことばの意味や使用から、学習者の心理、異文化コミュニケーション、
        人とAIとの関わりまで多岐にわたります。学生それぞれの関心に応じてテーマを設定しています。
      </p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <h2 class="section-title">卒業研究のテーマ例<span class="en">Past Themes</span></h2>
      <ul class="theme-grid">
        {research.past_themes.map((t, i) => (
          <li>
            <span class="theme-num">{String(i + 1).padStart(2, '0')}</span>
            <p>{t}</p>
          </li>
        ))}
      </ul>
      <p class="note theme-note">
        上記は過去に取り組まれたテーマの一例です。
      </p>
    </div>
  </section>
</Base>

<style>
  .theme-grid {
    list-style: none; margin: 0 0 1.5rem; padding: 0;
    display: grid; gap: 1px; background: var(--rule); border: 1px solid var(--rule);
  }
  @media (min-width: 44rem) { .theme-grid { grid-template-columns: repeat(2, 1fr); } }
  .theme-grid li {
    background: var(--paper); padding: 1.4rem;
    display: flex; gap: 1rem; align-items: baseline;
  }
  .theme-num {
    font-size: .78rem; font-weight: 700; letter-spacing: .08em;
    color: var(--teal-600); flex: none;
  }
  .theme-grid p { margin: 0; font-size: .95rem; font-weight: 500; color: var(--navy-900); }
  .theme-note { max-width: var(--text-w); }
</style>
