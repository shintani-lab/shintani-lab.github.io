---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { site, research, career, join } from '../lib/content';
import { iconForField } from '../lib/icons';
---
<Base
  title="配属を検討している方へ"
  description="芝浦工業大学 認知言語学・言語データ分析研究室（新谷研）への配属を検討している方へ。ゼミの内容、学べる分野、卒業後の進路をご紹介します。プログラミングや統計解析が初めての方も歓迎します。"
>
  <PageHead title="配属を検討している方へ" en="Join Us" />

  <section class="section">
    <div class="container">
      <div class="prose lead">
        <p>{research.introduction[2] ?? research.introduction[0]}</p>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <h2 class="section-title">学べる分野<span class="en">Fields</span></h2>
      <ul class="skill-list" role="list">
        {research.fields.map((f) => (
          <li>
            <Icon name={iconForField(f)} size={22} />
            <span>{f}</span>
          </li>
        ))}
      </ul>
      <p class="note skill-note">
        プログラミングや統計解析が初めての方でも、段階的に学べるよう指導しています。
        ことばや人のこころに関心があり、データから考えることに興味のある方を歓迎します。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">ゼミ実施日<span class="en">Weekly Seminar Schedule</span></h2>
      <p class="prose">{join.seminar.intro}</p>
      <ul class="slot-list" role="list">
        {join.seminar.slots.map((s) => <li>{s}</li>)}
      </ul>
      <p class="note slot-note">{join.seminar.note}</p>

      {join.photos && join.photos.length > 0 && (
        <div class="photo-grid">
          {join.photos.map((photo) => (
            <figure class="photo">
              <img
                src={photo.src}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                loading="lazy"
              />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <h2 class="section-title">
        大学院進学・留学生の方へ<span class="en">Graduate &amp; International</span>
      </h2>
      <dl class="admission">
        {(join.admission ?? []).map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.body}</dd>
          </div>
        ))}
      </dl>
      <p class="note admission-note">
        ご相談は <a href="/contact/">連絡先ページ</a>のメールアドレスまでお願いします。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">卒業後の進路<span class="en">Career</span></h2>
      <ul class="career-list" role="list">
        {career.categories.map((c) => <li>{c}</li>)}
      </ul>
      <p class="note career-note">{career.note}</p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <h2 class="section-title">お問い合わせ<span class="en">Contact</span></h2>
      <p class="prose">
        ゼミの見学や、研究内容についてのご質問を歓迎しています。
        まずはお気軽にご連絡ください。
      </p>
      <div class="join-actions">
        <a class="btn" href="/contact/">連絡先を見る</a>
        <a class="btn btn--ghost" href={site.professor.links.university} target="_blank" rel="noopener">
          大学公式ページ
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .skill-list, .career-list {
    list-style: none; margin: 0 0 1.5rem; padding: 0;
    display: grid; gap: .75rem;
  }
  @media (min-width: 34rem) {
    .skill-list, .career-list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 56rem) {
    .skill-list, .career-list { grid-template-columns: repeat(3, 1fr); }
  }
  .skill-list li {
    display: flex; align-items: center; gap: .8rem;
    background: var(--paper); border-left: 3px solid var(--teal-600);
    padding: .9rem 1.1rem; font-size: .92rem; font-weight: 500; color: var(--navy-900);
  }
  .skill-list li :global(.icon) { color: var(--teal-600); }
  .career-list li {
    background: var(--tint); padding: .9rem 1.1rem;
    font-size: .92rem; font-weight: 500; color: var(--navy-900);
    border: 1px solid var(--rule);
  }
  .skill-note, .career-note { max-width: var(--text-w); }

  .slot-list { list-style: none; margin: 1.25rem 0 0; padding: 0; max-width: var(--text-w); }
  .slot-list li {
    border-left: 3px solid var(--teal-600); background: var(--tint);
    padding: .8rem 1.1rem; font-size: .92rem; color: var(--navy-900);
  }
  .slot-list li + li { margin-top: .5rem; }
  .slot-note { margin-top: 1.25rem; max-width: var(--text-w); }

  .photo-grid { display: grid; gap: 1.5rem; margin-top: 2rem; }
  @media (min-width: 44rem) { .photo-grid { grid-template-columns: repeat(2, 1fr); } }
  .photo { margin: 0; }
  .photo img {
    width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover;
    border: 1px solid var(--rule); background: var(--tint);
  }
  .photo figcaption {
    margin-top: .7rem; font-size: .82rem; color: var(--muted); line-height: 1.8;
  }

  .admission { margin: 0; max-width: var(--text-w); }
  .admission > div { padding: 1.1rem 0; border-top: 1px solid var(--rule); }
  .admission > div:last-child { border-bottom: 1px solid var(--rule); }
  .admission dt {
    font-size: .9rem; font-weight: 700; color: var(--navy-900); margin-bottom: .4rem;
  }
  .admission dd { margin: 0; font-size: .92rem; }
  .admission-note { margin-top: 1.25rem; max-width: var(--text-w); }
  .join-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }
</style>
