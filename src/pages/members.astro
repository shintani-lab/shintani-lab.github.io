---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site, students, studentsByGrade, professorExtra } from '../lib/content';
---
<Base
  title="メンバー"
  description="芝浦工業大学 認知言語学・言語データ分析研究室（新谷研）のメンバーです。教員の新谷真由と、在籍する学生の学年・氏名をご紹介します。"
>
  <PageHead title="メンバー" en="Members" />

  <!-- 教員 -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">教員<span class="en">Faculty</span></h2>
      <div class="faculty">
        <p class="faculty-name">
          {site.professor.name_ja}
          <span class="faculty-kana">{site.professor.name_kana}</span>
        </p>
        <p class="faculty-title">
          {site.professor.affiliation}　{site.professor.title}
        </p>

        {site.professor.profile && (
          <p class="faculty-profile">{site.professor.profile}</p>
        )}

        {professorExtra.length > 0 && (
          <dl class="faculty-extra">
            {professorExtra.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.body}</dd>
              </div>
            ))}
          </dl>
        )}

        <ul class="faculty-links" role="list">
          <li>
            <a href={site.professor.links.researchmap} target="_blank" rel="noopener">
              researchmap
            </a>
          </li>
          <li>
            <a href={site.professor.links.university} target="_blank" rel="noopener">
              大学公式の研究室ページ
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 学生 -->
  <section class="section section--tint">
    <div class="container">
      <h2 class="section-title">学生<span class="en">Students</span></h2>

      {students.length === 0 ? (
        <p class="note">学生メンバーの情報は準備中です。</p>
      ) : (
        <div class="grades">
          {studentsByGrade.map((group) => (
            <div class="grade-block">
              <h3 class="grade-name">{group.grade}</h3>
              <ul class="student-list" role="list">
                {group.list.map((s) => (
                  <li>
                    <span class="student-name">{s.name}</span>
                    {s.theme && <span class="student-theme">{s.theme}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .faculty { max-width: var(--text-w); }
  .faculty-name {
    font-size: 1.35rem; font-weight: 700; color: var(--navy-900);
    margin: 0 0 .3rem; display: flex; align-items: baseline; gap: .8rem; flex-wrap: wrap;
  }
  .faculty-kana { font-size: .78rem; font-weight: 400; color: var(--muted); }
  .faculty-title { margin: 0 0 1.25rem; color: var(--text); font-size: .95rem; }
  .faculty-profile { margin: 0 0 1.5rem; font-size: .95rem; }

  .faculty-extra { margin: 0 0 1.5rem; }
  .faculty-extra > div {
    padding: 1rem 0; border-top: 1px solid var(--rule);
  }
  .faculty-extra > div:last-child { border-bottom: 1px solid var(--rule); }
  .faculty-extra dt {
    font-size: .8rem; font-weight: 500; color: var(--teal-600); margin-bottom: .4rem;
  }
  .faculty-extra dd { margin: 0; font-size: .92rem; }

  .faculty-links { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .faculty-links a { font-size: .9rem; font-weight: 500; }

  .grades { display: grid; gap: 2.5rem; }
  @media (min-width: 48rem) { .grades { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .grade-name {
    font-size: .95rem; font-weight: 700; color: var(--teal-600);
    margin: 0 0 .8rem; padding-bottom: .5rem; border-bottom: 1px solid var(--rule);
  }
  .student-list { list-style: none; margin: 0; padding: 0; }
  .student-list li { padding: .55rem 0; }
  .student-list li + li { border-top: 1px solid var(--rule-soft); }
  .student-name { display: block; font-size: .95rem; font-weight: 500; color: var(--navy-900); }
  .student-theme { display: block; font-size: .85rem; color: var(--muted); margin-top: .2rem; }
</style>
