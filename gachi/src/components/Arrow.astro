---
// 矢印アイコン（right = 右向き、out = 外部リンク）
interface Props { kind?: 'right' | 'out' | 'down'; size?: number }
const { kind = 'right', size = 16 } = Astro.props;
const d = {
  right: 'M3 8h10M9 4l4 4-4 4',
  out: 'M5 11 11 5M6 5h5v5',
  down: 'M8 3v10M4 9l4 4 4-4',
}[kind];
---
<svg width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={d} /></svg>
