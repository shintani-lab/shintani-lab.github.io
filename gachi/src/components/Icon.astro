---
// アイコン集です。すべて手書きのSVGで、外部のライブラリは使っていません。
// 増やしたいときは下の icons に1行足してください（24×24で描いたときの線の形）。
interface Props {
  name: string;
  size?: number;
}
const { name, size = 24 } = Astro.props;

const icons: Record<string, string> = {
  // 文書・テキスト
  text: '<path d="M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7z"/><path d="M14 3v4h4"/><path d="M9 12h6"/><path d="M9 16h4"/>',
  // プログラム
  code: '<path d="m9 8-4 4 4 4"/><path d="m15 8 4 4-4 4"/><path d="m13.5 6-3 12"/>',
  // 棒グラフ
  chart: '<path d="M4 20h16"/><path d="M7 17v-5"/><path d="M12 17V8"/><path d="M17 17V5"/>',
  // 人・社会
  people: '<circle cx="9" cy="8" r="3"/><path d="M3.5 19.5a5.5 5.5 0 0 1 11 0"/><path d="M16 5.6a3 3 0 0 1 0 5.8"/><path d="M17.5 14.4a5.5 5.5 0 0 1 3 5.1"/>',
  // つながり・認知
  network: '<circle cx="6" cy="7" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="12" cy="13" r="2"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="18" r="2"/><path d="m7.7 8.4 3 3.2"/><path d="m16.4 7.5-3 4"/><path d="m10.5 14.3-2.9 3.1"/><path d="m13.6 14.4 2.9 2.4"/>',
  // 学び・教育
  cap: '<path d="m2.5 8.5 9.5-4 9.5 4-9.5 4z"/><path d="M6.5 10.8V15c0 1.7 2.5 3 5.5 3s5.5-1.3 5.5-3v-4.2"/>',
  // 測定
  gauge: '<path d="M3.5 18a8.5 8.5 0 1 1 17 0"/><path d="m12 18 4.5-5.5"/><circle cx="12" cy="18" r="1.2"/>',
  // 予備（該当するアイコンが無いとき）
  dot: '<circle cx="12" cy="12" r="4.5"/>',
};

const shape = icons[name] ?? icons.dot;
---
<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
><Fragment set:html={shape} /></svg>

<style>
  .icon { display: block; flex: none; }
</style>
