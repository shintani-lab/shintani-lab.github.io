---
// 研究テーマページ
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import SectionHead from '../components/SectionHead.astro';
import Arrow from '../components/Arrow.astro';
import { research, pad2, url } from '../lib/data';
import { titles, CYCLE } from '../lib/lang';

const studentThemes = research.student_themes ?? [];

// 『』で囲まれた語は、蛍光ペンで目立たせます
const splitBrackets = (s: string) =>
  s.split(/(『[^』]+』)/).filter(Boolean).map((p) => ({ text: p, em: p.startsWith('『') }));
---
<Layout title="研究テーマ" description="認知言語学・言語データ分析研究室の研究テーマと、最近の学生の研究テーマです。">
  <PageHead tokens={titles.projects} en="Projects">
    <p class="phead-lead">研究室として取り組んでいるテーマと、最近の学生の卒業研究・修士研究のテーマです。</p>
  </PageHead>

  <section class="section">
    <div class="container">
      <SectionHead num="01" en="Lab themes" ja="研究室の研究テーマ" />
      <ol class="themes" role="list">
        {research.themes.map((t, i) => (
          <li class={`theme pos-${CYCLE[i % CYCLE.length]}`} data-reveal>
            <span class="theme-num en">{pad2(i + 1)}</span>
            <h3 class="theme-text">{t}</h3>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {studentThemes.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <SectionHead num="02" en="Student themes" ja="最近の学生の研究テーマ" />
        <ul class="sthemes" role="list">
          {studentThemes.map((t, i) => (
            <li class={`stheme pos-${CYCLE[i % CYCLE.length]}`} data-reveal style={`--d:${(i % 3) * 80}ms`}>
              <span class="stheme-num mono">#{pad2(i + 1)}</span>
              <p class="stheme-text">
                {splitBrackets(t).map((p) => p.em ? <span class="mk">{p.text}</span> : p.text)}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section next">
    <div class="container next-grid">
      <a class="next-card pos-noun" href={url('/research/')}>
        <span class="mono">Research</span>
        <span class="next-title">研究内容とデータ分析の工程</span>
        <Arrow size={22} />
      </a>
      <a class="next-card pos-verb" href={url('/publications/')}>
        <span class="mono">Publications</span>
        <span class="next-title">学生の論文・研究発表</span>
        <Arrow size={22} />
      </a>
    </div>
  </section>
</Layout>

<style>
  .themes { border-top: 2px solid var(--ink); }
  .theme {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem 2rem;
    padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
    border-bottom: 1px solid var(--line);
    transition: background-color .4s;
  }
  @media (min-width: 48rem) {
    .theme { grid-template-columns: 7rem 1fr; align-items: center; }
  }
  .theme:hover { background: color-mix(in srgb, var(--c) 6%, transparent); }
  .theme-num {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    font-weight: 800;
    line-height: .9;
    /* 「4」などは線が重なった形のため、輪郭の上から背景色で中を塗って重なり線を隠します */
    color: var(--paper);
    -webkit-text-stroke: 3px var(--c);
    paint-order: stroke fill;
    transition: color .4s;
  }
  .theme:hover .theme-num { color: var(--c); }
  .theme-text {
    font-size: clamp(1.3rem, 2.8vw, 2.1rem);
    font-weight: 900;
    line-height: 1.5;
  }

  .sthemes {
    columns: 3 18rem;
    column-gap: 1rem;
  }
  .stheme {
    display: grid;
    gap: .75rem;
    break-inside: avoid;
    margin-bottom: 1rem;
    padding: 1.4rem 1.4rem 1.25rem;
    background: var(--paper);
    border-radius: var(--radius);
    border-left: 5px solid var(--c);
    box-shadow: var(--shadow);
    transition: transform .45s var(--ease);
  }
  .stheme:hover { transform: translateY(-4px) rotate(-.4deg); }
  .stheme-num { font-size: .75rem; color: var(--c-ink); font-weight: 700; }
  .stheme-text { font-weight: 700; line-height: 1.75; color: var(--ink); }

</style>
